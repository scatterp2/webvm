FROM --platform=linux/386 i386/debian:bookworm
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get clean && apt-get update && apt-get -y upgrade

# Added 'sudo' to the package list
RUN apt-get -y install apt-utils gcc \
	python3 vim unzip ruby nodejs \
	fakeroot dbus base whiptail hexedit \
	patch wamerican ucf manpages \
	file luajit make lua5.4 dialog curl \
	less cowsay netcat-openbsd sudo

# Create user and set password
RUN useradd -m user && echo "user:password" | chpasswd

# Add user to the sudo group
RUN usermod -aG sudo user

# Configure sudo to not require a password for the 'user' account
# This creates a file in /etc/sudoers.d/ that allows 'user' to run any command as root without a password
RUN echo "user ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/user && chmod 0440 /etc/sudoers.d/user

COPY --chown=user:user ./examples /home/user/examples
RUN chmod -R +x  /home/user/examples/lua

WORKDIR /home/user/
ENV HOME="/home/user" TERM="xterm" USER="user" SHELL="/bin/bash" EDITOR="vim" LANG="en_US.UTF-8" LC_ALL="C"

# Root password is still set, but you won't need it if you use 'sudo' as 'user'
RUN echo 'root:password' | chpasswd

CMD [ "/bin/bash" ]
