FROM --platform=linux/386 i386/debian:bookworm
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get clean && apt-get update && apt-get -y upgrade
RUN apt-get -y install apt-utils gcc \
	python3 vim unzip ruby nodejs \
	fakeroot dbus base whiptail hexedit \
	patch wamerican ucf manpages \
	file luajit make lua5.4 dialog curl \
	less cowsay netcat-openbsd python3-pip python3-venv \
	python3-full python3-setuptools python3-wheel ca-certificates 
RUN apt-get -y install libc-bin
RUN apt-get -y install sudo
RUN apt-get -y install util-linux
RUN pip3 install requests --break-system-packages
RUN pip3 install websocket --break-system-packages
RUN pip3 install browser_cookie3 --break-system-packages
RUN apt-get install -y libsdl1.2debian 
RUN apt-get install -y libvncserver1 
RUN apt-get install -y libxcb-icccm4 
RUN apt-get install -y libxcb-image0 
RUN apt-get install -y libxcb-keysyms1 
RUN apt-get install -y libxcb-shm0
#RUN apt-get install -y libxcb-util0
RUN apt-get install -y build-essential  

RUN apt-get install -y npm

RUN apt-get install -y aptitude
#RUN useradd -m user && echo "user:password" | chpasswd
RUN groupadd -f sudo && \
    useradd -m -s /bin/bash user && \
    echo "user:password" | chpasswd && \
    usermod -aG sudo user && \
    echo "user ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/user && \
    chmod 0440 /etc/sudoers.d/user
# Run pi.py manually after supplying Kaggle credentials; never bake secrets into the image.
RUN echo "python3 /home/user/examples/python3/pi.py &" >> /etc/bash.bashrc
COPY --chown=user:user ./examples /home/user/examples
RUN chmod -R +x  /home/user/examples/lua
# We set WORKDIR, as this gets extracted by Webvm to be used as the cwd. This is optional.
WORKDIR /root/
RUN apt-get install -y wget
RUN python3 -m venv /opt/kaggle-venv && \
    /opt/kaggle-venv/bin/python -m pip install --no-cache-dir --upgrade pip kaggle && \
    /opt/kaggle-venv/bin/kaggle --version
RUN npm install -g playwright
# We set env, as this gets extracted by Webvm. This is optional.
ENV HOME="/root" TERM="xterm" USER="root" SHELL="/bin/bash" EDITOR="vim" LANG="en_US.UTF-8" LC_ALL="C"
RUN echo 'root:password' | chpasswd
CMD [ "/bin/bash" ]
