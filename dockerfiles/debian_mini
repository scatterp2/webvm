FROM --platform=linux/386 i386/debian:bookworm
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get clean && apt-get update && apt-get -y upgrade
RUN apt-get -y install apt-utils gcc \
	python3 vim unzip ruby nodejs \
	fakeroot dbus base whiptail hexedit \
	patch wamerican ucf manpages \
	file luajit make lua5.4 dialog curl \
	less cowsay netcat-openbsd python3-pip 
RUN apt-get -y install ldd
RUN apt-get -y install sudo
RUN apt-get -y install util-linux
RUN pip3 install requests --break-system-packages
RUN pip3 install websocket --break-system-packages
RUN pip3 install browser_cookie3 --break-system-packages
#RUN pip3 install websocket-client --break-system-packages
RUN apt-get -y install firefox-esr
RUN useradd -m user && echo "user:password" | chpasswd
RUN echo "echo changed to echo for safety in dockerfiles debian_mini python /home/user/examples/python3/pi.py &" >> /etc/bash.bashrc
COPY --chown=user:user ./examples /home/user/examples
RUN chmod -R +x  /home/user/examples/lua
# We set WORKDIR, as this gets extracted by Webvm to be used as the cwd. This is optional.
WORKDIR /home/user/
# We set env, as this gets extracted by Webvm. This is optional.
ENV HOME="/home/user" TERM="xterm" USER="user" SHELL="/bin/bash" EDITOR="vim" LANG="en_US.UTF-8" LC_ALL="C"
RUN echo 'root:password' | chpasswd
CMD [ "/bin/bash" ]
